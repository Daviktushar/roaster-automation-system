DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite
# To use MySQL, run scripts/create_mysql_database.ps1. It creates a local
# roster_automation database and writes MySQL settings to your private .env.
DB_NAME=roster_automation
DB_USER=roster_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
